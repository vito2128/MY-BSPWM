

[colors]
background = #1E1E2E
foreground = #FFFFFF
wallpaper = #0055b9


[bar/example]
width = 100%
height = 24pt
radius = 0
bottom = true

dpi = 192

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 3pt

border-size = 0pt
border-color = ${colors.background}

padding-left = 0
padding-right = 1

module-margin = 1

separator = |
separator-foreground = ${colors.background}

font-0 = Tahoma;2

modules-left = xworkspaces xwindow
modules-right = cpu-temp gpu-temp gpu-fan tray pulseaudio eth date

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true

[module/xworkspaces]
type = internal/xworkspaces

label-active = %name%
label-active-background = ${colors.wallpaper}
label-active-padding = 1

label-occupied = %name%
label-occupied-padding = 1

label-urgent = %name%
label-urgent-background = ${colors.background}
label-urgent-padding = 1

label-empty = %name%
label-empty-foreground = ${colors.foreground}
label-empty-padding = 1

[module/xwindow]
type = internal/xwindow
label = %title:0:60:...%


[module/pulseaudio]
type = internal/pulseaudio
format-volume-prefix = "VOL "
format-volume-prefix-foreground = ${colors.foreground}
format-volume = <label-volume>
label-volume = %percentage%%
label-muted = muted
label-muted-foreground = ${colors.foreground}
click-right = pavucontrol



[network-base]
type = internal/network
interval = 5
format-connected = <label-connected>
format-disconnected = <label-disconnected>
label-disconnected = %{F#F0C674}%ifname%%{F#707880} disconnected

[module/wlan]
inherit = network-base
interface-type = wireless
label-connected = %{F#F0C674}%ifname%%{F-} %essid% %local_ip%

[module/eth]
inherit = network-base
interface-type = wired
label-connected = %{F#F0C674}%ifname%%{F-} %local_ip%

[module/date]
type = internal/date
interval = 1

date = %H:%M
date-alt = %Y-%m-%d %H:%M:%S

label = %date%
label-foreground = ${colors.foreground}

[module/tray]
type = internal/tray
format-margin = 8px
tray-spacing = 8px


[module/gpu-temp]
type = custom/script
exec = cat /sys/class/hwmon/hwmon2/temp1_input
interval = 2
label = %output%°C
format-prefix = "GPU "
format-prefix-foreground = #a9b7c6


[module/gpu-fan]
type = custom/script
exec = cat /sys/class/hwmon/hwmon2/fan1_input
interval = 2
label = %output%°C
format-prefix = "GFAN "
format-prefix-foreground = #a9b7c6






[module/cpu-temp]
type = custom/script
exec = cat /sys/class/hwmon/hwmon8/temp1_input                             
interval = 2 
label = %output%°C
format-prefix = "CPU "
format-prefix-foreground = #a9b7c6




[settings]
screenchange-reload = true
pseudo-transparency = true
wm-restack = bspwm
override-redirect = true
